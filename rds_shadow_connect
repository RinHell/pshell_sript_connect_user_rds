$Script:CachedSessions = @();

function Update-PermissionsUI {
    $CurrentUser = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name;

    if ($Grid.SelectedRows.Count -gt 0) {
        $SelectedServer = $Grid.SelectedRows[0].Cells["Server"].Value;
        $PermObj = $Script:ServerPermissions[$SelectedServer];

        if ($PermObj) {
            $LabelPerms.Text = "Специалист: $CurrentUser | Сервер: $SelectedServer | Доступные права: $($PermObj.Summary)";
            $BtnConnect.Enabled = $PermObj.CanShadow;
            $BtnLogoff.Enabled  = $PermObj.CanLogoff;
        }
    } else {
        $FirstServer = $Script:ServerPermissions.Keys | Select-Object -First 1;
        if ($FirstServer) {
            $PermObj = $Script:ServerPermissions[$FirstServer];
            $LabelPerms.Text = "Специалист: $CurrentUser | Доступные права (на $FirstServer): $($PermObj.Summary)";
            $BtnConnect.Enabled = $PermObj.CanShadow;
            $BtnLogoff.Enabled  = $PermObj.CanLogoff;
        } else {
            $LabelPerms.Text = "Специалист: $CurrentUser | Серверы недоступны";
        }
    }
}

function Update-GridDisplay {
    $Filter = $TextBoxSearch.Text.Trim();
    $ShowInactive = $CheckShowInactive.Checked;

    $Filtered = $Script:CachedSessions | Where-Object {
        $MatchSearch = [string]::IsNullOrEmpty($Filter) -or
            $_.User -like "*$Filter*" -or
            $_.Server -like "*$Filter*" -or
            $_.ID -eq $Filter -or
            $_.State -like "*$Filter*";

        $MatchState = $ShowInactive -or ($_.State -match "Active|Актив");
        $MatchSearch -and $MatchState;
    };

    $Table = New-Object System.Data.DataTable;
    $null = $Table.Columns.Add("Server", [string]);
    $null = $Table.Columns.Add("User", [string]);
    $null = $Table.Columns.Add("ID", [string]);
    $null = $Table.Columns.Add("State", [string]);
    $null = $Table.Columns.Add("IdleTime", [string]);
    $null = $Table.Columns.Add("LogonTime", [string]);

    foreach ($Item in $Filtered) {
        $IdleVal  = if ($Item.PSObject.Properties['IdleTime']) { $Item.IdleTime } else { "" };
        $LogonVal = if ($Item.PSObject.Properties['LogonTime']) { $Item.LogonTime } else { "" };
        $null = $Table.Rows.Add($Item.Server, $Item.User, $Item.ID, $Item.State, $IdleVal, $LogonVal);
    }

    $Grid.DataSource = $Table;
    $LabelCount.Text = "Показано: $($Table.Rows.Count) из $($Script:CachedSessions.Count)";
    Update-PermissionsUI;
}

function Refresh-Data {
    $Form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor;
    $BtnRefresh.Enabled = $false;
    $LabelCount.Text = "Опрос серверов...";
    $LabelPerms.Text = "Проверка прав доступа на серверах...";
    [System.Windows.Forms.Application]::DoEvents();

    $Script:CachedSessions = Get-RDSSessions;
    Update-GridDisplay;

    $BtnRefresh.Enabled = $true;
    $Form.Cursor = [System.Windows.Forms.Cursors]::Default;
}

