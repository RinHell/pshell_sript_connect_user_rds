# Функция проверки прав текущего специалиста на сервере через WMI (RDP-Tcp)
function Get-RDSUserPermissions {
    param([string]$ServerName);

    $Perms = [PSCustomObject]@{
        CanShadow     = $false;
        CanLogoff     = $false;
        CanDisconnect = $false;
        CanMessage    = $false;
        Summary       = "Нет данных (WMI недоступен)";
    };

    try {
        $Identity = [System.Security.Principal.WindowsIdentity]::GetCurrent();
        $UserSids = @($Identity.User.Value);
        foreach ($Group in $Identity.Groups) {
            $UserSids += $Group.Value;
        }

        $TsPerm = Get-CimInstance -ComputerName $ServerName -Namespace "root\CIMV2\TerminalServices" -ClassName "Win32_TSPermissionsSetting" -Filter "TerminalName='RDP-Tcp'" -ErrorAction Stop;
        $SDResult = Invoke-CimMethod -InputObject $TsPerm -MethodName "GetSecurityDescriptor" -ErrorAction Stop;

        if ($SDResult.ReturnValue -eq 0 -and $SDResult.Descriptor) {
            $TotalMask = 0;
            foreach ($Ace in $SDResult.Descriptor.DACL) {
                if ($Ace.AceType -eq 0 -and $Ace.Trustee -and ($UserSids -contains $Ace.Trustee.SIDString)) {
                    $TotalMask = $TotalMask -bor [int]$Ace.AccessMask;
                }
            }

            $Perms.CanShadow     = (($TotalMask -band 16) -eq 16);
            $Perms.CanDisconnect = (($TotalMask -band 32) -eq 32);
            $Perms.CanLogoff     = (($TotalMask -band 64) -eq 64);
            $Perms.CanMessage    = (($TotalMask -band 128) -eq 128);

            $AllowedList = @();
            if ($Perms.CanShadow)     { $AllowedList += "Подключение (Shadow)"; }
            if ($Perms.CanLogoff)     { $AllowedList += "Завершение сеанса"; }
            if ($Perms.CanDisconnect) { $AllowedList += "Отключение"; }
            if ($Perms.CanMessage)    { $AllowedList += "Сообщения"; }

            if ($AllowedList.Count -gt 0) {
                $Perms.Summary = $AllowedList -join ", ";
            } else {
                $Perms.Summary = "Только просмотр списка (нет прав на управление)";
            }
        }
    } catch {
        $Perms.Summary = "Проверка WMI ограничена (нужны права на root\CIMV2\TerminalServices)";
        $Perms.CanShadow = $true;
        $Perms.CanLogoff = $true;
    }

    return $Perms;
}

$Script:ServerPermissions = @{};

function Get-RDSSessions {
    $Results = New-Object System.Collections.ArrayList;
    $Script:ServerPermissions.Clear();

    foreach ($Server in $Servers) {
        $Tcp = New-Object System.Net.Sockets.TcpClient;
        $Connect = $Tcp.BeginConnect($Server, 3389, $null, $null);
        $IsOnline = $Connect.AsyncWaitHandle.WaitOne(500, $false);
        $Tcp.Close();

        if ($IsOnline) {
            $Script:ServerPermissions[$Server] = Get-RDSUserPermissions -ServerName $Server;

            $Lines = query session /server:$Server 2>$null | Select-Object -Skip 1;
            foreach ($Line in $Lines) {
                $CleanLine = $Line.Trim();
                if ([string]::IsNullOrWhiteSpace($CleanLine)) { continue; }

                $Parts = $CleanLine -split '\s{2,}';
                if ($Parts.Count -lt 3) { continue; }

                $SessionName = "";
                $User        = "";
                $ID          = "";
                $State       = "";

                if ($Parts[0] -match '^(>?rdp-tcp|console|services)') {
                    if ($Parts[1] -match '^\d+$') { continue; }
                    $SessionName = $Parts[0] -replace '^>', '';
                    $User        = $Parts[1];
                    $ID          = $Parts[2];
                    $State       = if ($Parts.Count -ge 4) { $Parts[3] } else { "" };
                }
                elseif ($Parts[1] -match '^\d+$') {
                    $User  = $Parts[0] -replace '^>', '';
                    $ID    = $Parts[1];
                    $State = if ($Parts.Count -ge 3) { $Parts[2] } else { "" };
                }
                else {
                    continue;
                }

                $null = $Results.Add([PSCustomObject]@{
                    Server  = $Server;
                    User    = $User;
                    ID      = $ID;
                    State   = $State;
                    Session = $SessionName
                });
            }

            $QuserLines = quser /server:$Server 2>$null | Select-Object -Skip 1;
            foreach ($QLine in $QuserLines) {
                $QParts = $QLine.Trim() -split '\s{2,}';
                if ($QParts.Count -ge 4) {
                    $QID    = if ($QParts[1] -match '^\d+$') { $QParts[1] } else { $QParts[2] };
                    $QIdle  = if ($QParts[1] -match '^\d+$') { $QParts[3] } else { if ($QParts.Count -ge 5) { $QParts[4] } else { "" } };
                    $QLogon = if ($QParts[1] -match '^\d+$') { if ($QParts.Count -ge 5) { $QParts[4] } else { "" } } else { if ($QParts.Count -ge 6) { $QParts[5] } else { "" } };

                    $Match = $Results | Where-Object { $_.Server -eq $Server -and $_.ID -eq $QID };
                    if ($Match) {
                        $Match | Add-Member -NotePropertyName "IdleTime" -NotePropertyValue $QIdle -Force;
                        $Match | Add-Member -NotePropertyName "LogonTime" -NotePropertyValue $QLogon -Force;
                    }
                }
            }
        }
    }
    return ,$Results;
}

