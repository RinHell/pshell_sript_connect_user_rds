$ConnectAction = {
    if (-not $BtnConnect.Enabled) { return; }
    if ($Grid.SelectedRows.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Выберите сессию из списка.", "Внимание", "OK", "Warning");
        return;
    }
    $Row = $Grid.SelectedRows[0];
    $TargetServer = $Row.Cells["Server"].Value;
    $TargetID     = $Row.Cells["ID"].Value;
    $TargetState  = $Row.Cells["State"].Value;

    if ($TargetState -notmatch "Active|Актив") {
        [System.Windows.Forms.MessageBox]::Show("Невозможно подключиться к неактивной (отключенной) сессии. Пользователь должен быть в сети.", "Ошибка подключения", "OK", "Warning");
        return;
    }

    Start-Process "mstsc.exe" -ArgumentList "/v:$TargetServer /shadow:$TargetID /control";
};

$BtnConnect.Add_Click($ConnectAction);
$Grid.Add_CellDoubleClick($ConnectAction);

$BtnLogoff.Add_Click({
    if (-not $BtnLogoff.Enabled) { return; }
    if ($Grid.SelectedRows.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Выберите сессию для завершения.", "Внимание", "OK", "Warning");
        return;
    }
    $Row = $Grid.SelectedRows[0];
    $TargetServer = $Row.Cells["Server"].Value;
    $TargetUser   = $Row.Cells["User"].Value;
    $TargetID     = $Row.Cells["ID"].Value;

    $Confirm = [System.Windows.Forms.MessageBox]::Show(
        "Вы действительно хотите принудительно завершить сессию пользователя '$TargetUser' (ID: $TargetID) на сервере $TargetServer?`n`nНесохраненные данные пользователя будут потеряны.",
        "Подтверждение завершения сессии",
        "YesNo",
        "Question"
    );

    if ($Confirm -eq "Yes") {
        $Output = logoff $TargetID /server:$TargetServer 2>&1;
        if ($LASTEXITCODE -eq 0) {
            [System.Windows.Forms.MessageBox]::Show("Сессия пользователя $TargetUser успешно завершена.", "Готово", "OK", "Information");
            Refresh-Data;
        } else {
            [System.Windows.Forms.MessageBox]::Show("Не удалось завершить сессию.`nОшибка: $Output", "Ошибка", "OK", "Error");
        }
    }
});

